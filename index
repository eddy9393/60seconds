<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>60seconds.fm</title>

<style>
body {
  margin: 0;
  background: #0b0b0b;
  color: #fff;
  font-family: Arial, sans-serif;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hero {
  text-align: center;
  margin-top: 60px;
}

.hero h1 {
  font-size: 48px;
  color: gold;
}

.radio {
  margin-top: 50px;
  background: #111;
  padding: 30px;
  border-radius: 20px;
  width: 400px;
  text-align: center;
}

button {
  margin: 10px;
  padding: 10px 20px;
  background: gold;
  border: none;
  cursor: pointer;
}
</style>

</head>
<body>

<div class="hero">
  <h1>Discover music in 60 seconds</h1>
</div>

<div class="radio">
  <h2>Track Name</h2>
  <p>Artist Name</p>

  <button>❤️ Like</button>
  <button>⏭ Skip</button>

  <p>🔥 12,398 drops</p>
  <p>▶ 220 plays</p>
</div>

</body>
</html>
